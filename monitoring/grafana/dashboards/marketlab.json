{
  "uid": "marketlab-r8",
  "title": "MarketLab R8 operations",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "marketlab",
    "r8"
  ],
  "description": "Process metrics reset at exit/restart. Missing/stale state is unavailable. Durable aggregates are gauges. Model/child memory needs the independent benchmark sampler.",
  "panels": [
    {
      "id": 1,
      "title": "Telemetry targets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "marketlab-r8-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"marketlab-.*\"}",
          "legendFormat": "{{job}} {{kind}} {{state}} {{outcome}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Durable snapshot available (0 means unavailable)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "marketlab-r8-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "marketlab_durable_available",
          "legendFormat": "{{job}} {{kind}} {{state}} {{outcome}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Durable jobs by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "marketlab-r8-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "marketlab_durable_jobs and on(instance) (marketlab_durable_available == 1)",
          "legendFormat": "{{job}} {{kind}} {{state}} {{outcome}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
