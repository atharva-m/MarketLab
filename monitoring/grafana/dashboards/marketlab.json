    {
      "id": 6,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "marketlab-r8-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route,status) (rate(marketlab_http_requests_total[1m]))",
          "legendFormat": "{{job}} {{kind}} {{state}} {{outcome}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
