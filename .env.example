MARKETLAB_ENVIRONMENT=local
MARKETLAB_DATABASE_URL=postgresql+psycopg://marketlab:marketlab@127.0.0.1:5432/marketlab
MARKETLAB_REDIS_URL=redis://127.0.0.1:6379/0
MARKETLAB_OLLAMA_URL=http://127.0.0.1:11434
MARKETLAB_STORAGE_PATH=./data
MARKETLAB_DEPENDENCY_TIMEOUT_SECONDS=3
MARKETLAB_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Compose binds published ports to localhost. Change these if a local service uses them.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_PASSWORD=marketlab
OLLAMA_HOST_URL=http://host.docker.internal:11434
# AWS credentials
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=<AWS_REGION>
S3_BUCKET_NAME=<S3_BUCKET_NAME>
