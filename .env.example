MARKETLAB_ENVIRONMENT=local
MARKETLAB_DATABASE_URL=postgresql+psycopg://marketlab:marketlab@127.0.0.1:5432/marketlab
MARKETLAB_REDIS_URL=redis://127.0.0.1:6379/0
MARKETLAB_OLLAMA_URL=http://127.0.0.1:11434
MARKETLAB_STORAGE_PATH=./data
MARKETLAB_DEPENDENCY_TIMEOUT_SECONDS=3
MARKETLAB_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Default local storage needs no AWS account. To use an existing versioned
# AWS bucket, set the backend to s3 and uncomment the values below in .env.
MARKETLAB_STORAGE_BACKEND=local
# S3_BUCKET_NAME=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# MARKETLAB_STORAGE_S3_PREFIX=marketlab
# MARKETLAB_STORAGE_S3_ENDPOINT=

# Set this to the provisioned root UUID on each distributed host.
# MARKETLAB_WORKER_ROOT_ID=
# MARKETLAB_COPILOT_MODEL=qwen3.5:9b-q4_K_M
# MARKETLAB_COPILOT_MODEL_DIGEST=56671c2ab9385f9cfcb404638e32cd62d88e3501d44822208363c010179a3c90

# Compose binds published ports to localhost. Change these if a local service uses them.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_PASSWORD=marketlab
OLLAMA_HOST_URL=http://host.docker.internal:11434
